{
  "compilerOptions": {
    "strict": true,
    "typeRoots": [
      "./node_modules/@types",
      "./types"
    ],
    "jsx": "preserve",
    "incremental": true,
    "module": "esnext",
    "isolatedModules": true
  },
  "extends": "expo/tsconfig.base",
  "include": [
    "app/**/*",
    "components/**/*",
    "services/**/*",
    "hooks/**/*",
    "store/**/*",
    "contexts/**/*",
    "providers/**/*",
    "utils/**/*",
    "lib/**/*",
    "config/**/*",
    "constants/**/*",
    "types/**/*",
    "theme/**/*",
    "navigator/**/*"
  ],
  "exclude": [
    "node_modules",
    "supabase/functions",
    "tests",
    "scripts",
    "DukaaOnWebsite",
    "Website",
    "old-website-backup",
    "src",
    "screens",
    "android",
    "patched-modules",
    "polyfills"
  ]
}
